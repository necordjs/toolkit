{
	"name": "necordjs-toolkit",
	"description": "🤖 Source code of Toolkit bot",
	"version": "1.6.2",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepare": "husky",
		"format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
		"lint": "oxlint --type-aware --deny-warnings src",
		"prestart": "npm run build",
		"start": "node --enable-source-maps dist/main.js",
		"start:dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
		"publish": "release-it",
		"publish:git": "release-it",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:ci": "vitest run --coverage"
	},
	"lint-staged": {
		"*.ts": "npm run format"
	},
	"directories": {
		"lib": "src",
		"test": "test"
	},
	"funding": {
		"type": "opencollective",
		"url": "https://opencollective.com/necord"
	},
	"keywords": [
		"toolkit",
		"nestjs",
		"necord"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/necordjs/toolkit.git"
	},
	"bugs": {
		"url": "https://github.com/necordjs/toolkit"
	},
	"author": "Alexey Filippov <socket.someone@gmail.com>",
	"contributors": [
		"Alexey Filippov <socket.someone@gmail.com>"
	],
	"dependencies": {
		"@necord/pagination": "3.0.0",
		"@nestjs/axios": "12.0.0",
		"@nestjs/common": "12.0.1",
		"@nestjs/config": "12.0.0",
		"@nestjs/core": "12.0.1",
		"@nestjs/microservices": "12.0.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/auto-instrumentations-node": "0.80.0",
		"@opentelemetry/exporter-prometheus": "0.222.0",
		"@opentelemetry/instrumentation-nestjs-core": "^0.68.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.35.0",
		"@opentelemetry/sdk-node": "0.222.0",
		"@sentry/cli": "^3.7.0",
		"@sentry/nestjs": "^10.73.0",
		"@sentry/opentelemetry": "^10.73.0",
		"@sentry/profiling-node": "^10.73.0",
		"axios": "1.20.0",
		"discord.js": "14.27.0",
		"discordjs-docs-parser": "1.3.3",
		"kleur": "4.1.5",
		"necord": "7.0.0",
		"nestjs-otel": "^8.1.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-angular": "21.2.2",
		"@nestjs/testing": "12.0.1",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/node": "26.4.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^10.0.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"reflect-metadata": "0.2.2",
		"release-it": "^21.0.2",
		"rimraf": "6.1.3",
		"rxjs": "7.8.2",
		"tsc-watch": "7.2.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.6.0"
	}
}
